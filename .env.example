# =============================================================================
# Durvaeco Flutter Environment Configuration
# =============================================================================
# Note: Flutter does NOT read from this file at runtime.
# Instead, compile-time constants are injected via `--dart-define`.
# This file serves as documentation for developers and CI/CD pipelines.
#
# See `docs/configuration.md` and `lib/core/config/app_config.dart`.
# =============================================================================

# API base URL for your local or remote backend
# - iOS Simulator:      http://localhost:3030
# - Android Emulator:   http://10.0.2.2:3030
# - Physical Device:    http://<LAN-IP>:3030
# - Staging:            https://staging-api.durvaeco.com
# - Production:         https://api.durvaeco.com
API_BASE_URL=http://localhost:3030

# Environment flag: local | dev | staging | production
APP_ENV=local

# Sentry DSN for crash reporting (optional for local development)
SENTRY_DSN=
